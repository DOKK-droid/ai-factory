+  local p
+  if [ "${1:-}" = docs ]; then
+    for p in 02-DOCS/wiki/jobs 02-DOCS/wiki/index.md 02-DOCS/wiki/project/project.ok 02-DOCS/wiki/project/trazabilidad.md; do printf '%s\n' ":(exclude)${p}"; done
+    return
+  fi
