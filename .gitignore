# =============================================================================
# AI Factory — .gitignore crítico (aislamiento entre proyectos)
# =============================================================================

# --- Dependencias ---
node_modules/
.bun/
.yarn/
.bun.lockb
yarn.lock
package-lock.json

# --- Entornos y secretos ---
.env
.env.*
.env.local
*.env
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.pyc
.venv/
venv/
.env

# --- RSC Harness (backups y sesiones, no commitear) ---
.rsc/backups/
.rsc/audit.json
.rsc/agent-digests.json

# --- OpenCode (config local, no commitear secretos) ---
.opencode/opencode.jsonc
~/.config/opencode/opencode.jsonc

# --- Logs ---
*.log
factory/logs/
npm-debug.log*

# --- Sistema ---
.DS_Store
Thumbs.db
*.swp
*.swo

# =============================================================================
# AISLAMIENTO CRÍTICO: Brain y jobs de otros proyectos
# =============================================================================

# Nunca commitear el Brain de otro proyecto dentro de este repo
02-DOCS/*/projects/
02-DOCS/other-project*/

# Nunca commitear jobs de otro proyecto
factory/jobs/*/other-project*/

# Nunca commitear configuración de factory ajena
factory/config.json.other-project*

# Datos de prueba y jobs temporales (mantener .gitkeep si se necesita estructura)
factory/jobs/*/
!factory/jobs/.gitkeep

# Backups de RSC
.rsc/backups/*

# =============================================================================
# Fin de .gitignore
# =============================================================================
