# =============================================================================
# AI Factory .gitignore
# =============================================================================

# --- Dependencias (los lockfiles SI se versionan: reproducibilidad y supply chain) ---
node_modules/
.bun/
.yarn/

# --- Entornos y secretos ---
.env
.env.*
*.env
!.env.example
!.env.sample
!.env.template

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Estado local de RSC / OpenCode (rutas de tu maquina, backups, sesiones) ---
.rsc/backups/
.rsc/audit.json
.rsc/agent-digests.json
.opencode/rsc/.rsc-state.json
.opencode/node_modules/
.opencode/opencode.jsonc

# --- Logs ---
*.log
npm-debug.log*
factory/logs/

# --- Sistema ---
.DS_Store
Thumbs.db
*.swp
*.swo

# --- Aislamiento: los jobs son del proyecto donde se ejecutaron, no de este repo ---
factory/jobs/*/
!factory/jobs/.gitkeep
factory/worktrees/

# --- Salidas de pruebas A/B ---
tests/ab/out/

# rsc local state (hooks, seals, logs) and managed skill links — machine-local
.rsc/
.worktrees/
.opencode/rsc/orient
.opencode/rsc/suggest
.opencode/rsc/unslop
.opencode/rsc/ftd
.opencode/rsc/connect-tool
.opencode/rsc/design
.opencode/rsc/ux
.opencode/rsc/tidy
.opencode/rsc/analyze
.opencode/rsc/automation-strategy
.opencode/rsc/clarify
.opencode/rsc/constitution
.opencode/rsc/debug
.opencode/rsc/decision-challenge
.opencode/rsc/deprecation
.opencode/rsc/fable-operator
.opencode/rsc/harness
.opencode/rsc/idea-refinement
.opencode/rsc/implement
.opencode/rsc/init
.opencode/rsc/parallel
.opencode/rsc/plan
.opencode/rsc/review
.opencode/rsc/sdd
.opencode/rsc/sdd-init
.opencode/rsc/ship
.opencode/rsc/simplify-code
.opencode/rsc/source-grounded-development
.opencode/rsc/specify
.opencode/rsc/tasks
.opencode/rsc/verify
.opencode/rsc/worktrees
