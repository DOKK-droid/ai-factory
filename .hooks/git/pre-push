#!/usr/bin/env bash
# pre-push: bloquea push a main/master salvo humano (FACTORY_HUMAN=1).
set -euo pipefail
[ "${FACTORY_HUMAN:-0}" = "1" ] && exit 0
while read -r _lref _lsha rref _rsha; do
  case "$rref" in
    refs/heads/main|refs/heads/master) echo "pre-push: push a ${rref#refs/heads/} bloqueado (humano: FACTORY_HUMAN=1)." >&2; exit 1 ;;
  esac
done
exit 0
