{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git commit": "allow",
      "git commit *": "allow",
      "git push": "deny",
      "git push *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git merge": "deny",
      "git merge *": "deny",
      "gh pr merge": "deny",
      "gh pr merge *": "deny",
      "git worktree add": "allow",
      "git worktree remove": "allow",
      "git worktree list": "allow",
      "git checkout": "allow",
      "git checkout *": "allow",
      "git add": "allow",
      "git add *": "allow",
      "git status": "allow",
      "git diff": "allow",
      "git log": "allow",
      "npm test": "allow",
      "npm test *": "allow",
      "npx jest": "allow",
      "npx jest *": "allow",
      "npx vitest": "allow",
      "npx vitest *": "allow",
      "npx eslint": "allow",
      "npx eslint *": "allow",
      "npx tsc": "allow",
      "npx tsc *": "allow",
      "node 01-TOOLS/*": "allow",
      "node factory/scripts/*": "allow",
      "npx @ericrisco/rsc@latest onboard": "ask",
      "npx @ericrisco/rsc@latest *": "ask",
      "npx @ericrisco/rsc@3.6.0 *": "allow",
      "gh pr create": "allow",
      "gh pr create *": "allow",
      "gh pr view": "allow",
      "gh pr view *": "allow",
      "gh auth status": "allow",
      "rm -rf *": "deny",
      "rm -rf": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny",
      "git branch -D*": "deny",
      "git branch -d*": "deny",
      "git update-ref*": "deny",
      "git filter-branch*": "deny",
      "gh api *": "deny",
      "gh pr review *": "deny",
      "gh pr ready*": "deny",
      "gh auth token*": "deny",
      "gh secret *": "deny",
      "gh repo delete*": "deny",
      "git push -u origin factory/*": "allow"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  }
}
