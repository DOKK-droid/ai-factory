{
  "permission": {
    "bash": {
      "git commit": "allow",
      "git commit *": "allow",
      "git push": "deny",
      "git push *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git merge": "deny",
      "git merge *": "deny",
      "gh pr merge": "deny",
      "gh pr merge *": "deny",
      "git worktree add": "allow",
      "git worktree remove": "allow",
      "git worktree list": "allow",
      "git checkout": "allow",
      "git checkout *": "allow",
      "git add": "allow",
      "git add *": "allow",
      "git status": "allow",
      "git diff": "allow",
      "git log": "allow",
      "npm test": "allow",
      "npm test *": "allow",
      "npx jest": "allow",
      "npx jest *": "allow",
      "npx vitest": "allow",
      "npx vitest *": "allow",
      "npx eslint": "allow",
      "npx eslint *": "allow",
      "npx tsc": "allow",
      "npx tsc *": "allow",
      "node 01-TOOLS/*": "allow",
      "node factory/scripts/*": "allow",
      "npx @ericrisco/rsc@latest onboard": "allow",
      "npx @ericrisco/rsc@latest *": "ask",
      "npx @ericrisco/rsc@3.6.0 *": "allow",
      "gh pr create": "allow",
      "gh pr create *": "allow",
      "gh pr view": "allow",
      "gh pr view *": "allow",
      "gh auth status": "allow",
      "rm -rf *": "deny",
      "rm -rf": "deny",
      "cat .env*": "deny",
      "read .env*": "deny"
    }
  },
  "plugins": [".opencode/plugins/factory-guard.js"],
  "$schema": "https://opencode.ai/config.json"
}
